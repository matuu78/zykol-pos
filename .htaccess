# zykol.POS – Browser-Cache
# Dateien mit ?v=<Hash> ändern ihre Adresse, sobald sich ihr Inhalt ändert: ein Jahr im Cache behalten.
# Alles andere (Schriften, Bilder, Bibliotheken ohne ?v=) einen Tag, index.html immer frisch prüfen.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|svg|jpg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <If "%{QUERY_STRING} =~ /^v=[0-9a-f]{10}$/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>
